# Telegram Bot Token (required)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token

# Allowed Telegram user IDs (required, comma-separated)
# Send /start to @userinfobot to get your ID
ALLOWED_USER_IDS=your-telegram-user-id

# Redis connection URL
REDIS_URL=redis://localhost:6379

# SQLite database path
DATABASE_PATH=./data/koreader-sync.db

# Bot mode: "polling" for local dev, "webhook" for production
BOT_MODE=polling

# Webhook URL (required when BOT_MODE=webhook)
# WEBHOOK_URL=https://your-domain.com/webhook

# HTTP server port
PORT=3000

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Firecrawl API key for web content extraction
# Get from https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-your-api-key

# OpenRouter API key for LLM content cleaning
# Get from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-your-api-key

# OpenRouter model for content cleaning (default: google/gemini-2.0-flash-001)
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# EPUB storage path (default: ./data/epubs)
# EPUB_STORAGE_PATH=./data/epubs

# Wallabag API shim login (all required). KOReader's Wallabag plugin and the
# new-tab extension's Settings use the same four values.
WALLABAG_USERNAME=reader
WALLABAG_PASSWORD=choose-a-long-password
WALLABAG_CLIENT_ID=choose-a-client-id
WALLABAG_CLIENT_SECRET=choose-a-long-client-secret

# Shared secret for inbound email webhook authentication
EMAIL_WEBHOOK_SECRET=your-email-webhook-secret
